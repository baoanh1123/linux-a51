// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy A51 device tree source
 */

/dts-v1/;

#include "exynos9611.dtsi"
#include <dt-bindings/clock/samsung,exynos9610-cmu.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/thermal/thermal.h>

/*
 * Model and generic compatible strings are from
 * notes/device-dump/20261026-1937/live-device-tree.dts:6-10.
 * No board-specific compatible has been found; do not infer one from the model.
 */
/ {
	model = "Samsung A51 EUR OPEN REV01 based on Exynos9611";
	compatible = "samsung,armv8", "samsung,exynos9610";

	mshc: mmc@13550000 {
		compatible = "samsung,exynos9611-dw-mshc";
		reg = <0x0 0x13550000 0x2000>;
		clocks = <&cmu_fsys CLK_FSYS_GOUT_MMC_CARD_ACLK>,
			 <&cmu_top CLK_TOP_GOUT_FSYS_MMC_CARD>,
			 <&cmu_fsys CLK_FSYS_GOUT_MMC_CARD_SDCLKIN>,
			 <&cmu_fsys CLK_FSYS_GOUT_MMC_CARD_QCH>;
		clock-names = "biu", "ciu", "sdclkin", "qch";
		/*
		 * Match the vendor identification setup: downstream reports
		 * "Bus speed = 24999996Hz (slot req 400000Hz, actual 390624Hz
		 * div = 32)" for CMD8/ACMD41, i.e. a ~25 MHz CIU with CLKDIV 32,
		 * and only raises the CIU per speed mode through its ciu_clkin
		 * table. mainline keeps a fixed CIU, and the composite clock's
		 * divider is read-only, so selecting a rate alone does nothing;
		 * select the 26 MHz oscillator on the MMC card mux instead.
		 * That switching per speed mode is the missing feature to
		 * implement once identification works.
		 */
		assigned-clocks = <&cmu_top CLK_TOP_MOUT_FSYS_MMC_CARD>;
		assigned-clock-parents = <&cmu_top CLK_TOP_FOUT_MMC_PLL>;
		interrupts = <GIC_SPI 147 IRQ_TYPE_LEVEL_HIGH>;
		fifo-depth = <64>;
		desc-size = <4>;
		card-detect-delay = <200>;
		cd-gpios = <&gpa2 4 GPIO_ACTIVE_HIGH>;
		/*
		 * Both card rails start at 3.3 V for non-UHS identification.
		 * The stock 1.8 V LDO2 value was read after the vendor kernel
		 * had already performed CMD11 and switched the card to UHS
		 * signaling; driving vqmmc at 1.8 V before that switch leaves
		 * the card's data outputs out of spec and was the state in
		 * which ACMD51/SCR read timed out. UHS support can widen these
		 * constraints later, after CMD11/tuning is implemented.
		 */
		vmmc-supply = <&vmmc_reg>;
		vqmmc-supply = <&vqmmc_reg>;
		bus-width = <4>;
		/*
		 * High Speed only.  UHS-I was tried and parked: the CMD11
		 * switch fails with the S2MPU09 vqmmc rail ("SD UHS voltage
		 * switch err=-11", then "CMD8 failure", so card enumeration
		 * fails).  Never re-enable sd-uhs-* without a working 1.8 V
		 * switch and tuning: this card is the boot medium and the
		 * failure mode is an unbootable board.
		 */
		max-frequency = <50000000>;
		no-1-8-v;
		disable-wp;
		cap-sd-highspeed;
		supports-4bit;
		supports-cmd23;
		samsung,dw-mshc-ciu-div = <3>;
		samsung,dw-mshc-sdr-timing = <0 2>;
		samsung,dw-mshc-ddr-timing = <0 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&dwmmc2_cd_ext_irq &sd2_clk &sd2_cmd &sd2_bus1
			     &sd2_bus4>;
		status = "okay";
	};

	/*
	 * USB2 peripheral-only bring-up. The PHY and controller rails are
	 * fixed always-on placeholders for this test; no GPIO or VBUS source
	 * is controlled here. dr_mode is fixed to peripheral and SuperSpeed
	 * is not enabled.
	 */
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	usb_vdd33: regulator-usb-vdd33 {
		compatible = "regulator-fixed";
		regulator-name = "usb-vdd33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	usb_vdd10: regulator-usb-vdd10 {
		compatible = "regulator-fixed";
		regulator-name = "usb-vdd10";
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1000000>;
		regulator-always-on;
	};

	usb_phy: phy@131d0000 {
		compatible = "samsung,exynos9610-usbdrd-phy";
		reg = <0x0 0x131d0000 0x200>;
		clocks = <&cmu_usb CLK_USB_QCH_USB30>,
			 <&cmu_usb CLK_USB_QCH_USBPHY_20CTRL>,
			 <&cmu_usb CLK_USB_QCH_USBPHY_30CTRL_0>,
			 <&cmu_usb CLK_USB_QCH_USBPHY_30CTRL_1>,
			 <&oscclk>;
		clock-names = "hsdrd", "usb20", "usb30_0", "usb30_1",
			      "ref";
		samsung,pmu-syscon = <&pmu_system_controller>;
		vbus-supply = <&usb_vbus>;
		vbus-boost-supply = <&usb_vbus>;
		#phy-cells = <1>;
		status = "okay";
	};

	usb: usb@13200000 {
		compatible = "samsung,exynos9610-dwusb3";
		reg = <0x0 0x13200000 0x10000>;
		clocks = <&cmu_usb CLK_USB_QCH_USB30>;
		clock-names = "hsdrd";
		vdd33-supply = <&usb_vdd33>;
		vdd10-supply = <&usb_vdd10>;
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;
		status = "okay";

		usb_dwc3: dwc3 {
			compatible = "snps,dwc3";
			reg = <0x0 0x13200000 0x10000>;
			interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb_phy 0>;
			phy-names = "usb2-phy";
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis_enblslpm_quirk;
			snps,dis_rxdet_inp3_quirk;
			status = "okay";
		};
	};

	/*
	 * Framebuffer values are from uniloader-bootloader/board/samsung/
	 * board-a51.c:10-24 and uniloader-bootloader/lib/simplefb/simplefb.c:43-48.
	 * Cell sizes follow MAINLINE/arch/arm64/boot/dts/exynos/
	 * exynos9810-starlte.dts:17-28.
	 */
	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;
		bootargs = "console=tty0 loglevel=7 printk.time=1 printk.always_kmsg_dump=Y rootfstype=ramfs net.ifnames=0";

		/*
		 * uniloader-bootloader/board/samsung/board-a51.c:10-24;
		 * byte order is from uniloader-bootloader/lib/simplefb/
		 * simplefb.c:43-48. Row pitch is 1080 * 4 = 4320.
		 */
		framebuffer@ca000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xca000000 0x9e3400>;
			width = <1080>;
			height = <2400>;
			stride = <4320>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Live memory banks: notes/device-dump/20261026-1937/live-device-tree.dts:
	 * 1904, 3110, 5360, 6492, 6587.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x3ab00000>,
		      <0x0 0xc0000000 0x20000000>,
		      <0x0 0xe1900000 0x1e700000>,
		      <0x8 0x80000000 0x80000000>,
		      <0x9 0x00000000 0x80000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "a51-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_volup &key_voldown &key_power>;

		volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * Reservation structure follows MAINLINE/arch/arm64/boot/dts/exynos/
	 * exynos9810-starlte.dts:68-82. The range is from
	 * uniloader-bootloader/board/samsung/board-a51.c:10-24, with byte size
	 * derived from 1080 * 2400 * 4.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		/*
		 * Framebuffer reservation from uniloader-bootloader/board/samsung/
		 * board-a51.c:10-24; size is derived from 1080 * 2400 * 4.
		 */
		framebuffer@ca000000 {
			reg = <0x0 0xca000000 0x9e3400>;
			no-map;
		};

		/*
		 * Contiguous pool for the display driver's GEM buffers.  The DPU
		 * IDMA channel takes plain 32-bit physical addresses, so scanout
		 * buffers have to be contiguous.  A 1080x2400 XRGB8888 frame is
		 * 10.4 MiB, so 64 MiB leaves room for double/triple buffering on
		 * top of the fbdev console buffer.  The pool is reusable, so
		 * unused pages still count as free memory.
		 */
		/*
		 * NOTE: the pool must live below 4 GiB.  Without alloc-ranges the
		 * allocator places it in the first large free area, which on this
		 * board is above 4 GiB (0x9_7e00000); the DPU IDMA channel only has
		 * 32-bit address registers, so dma_coherent_ok() rejects such pages
		 * and every scanout buffer allocation fails.
		 */
		cma_reserved: linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x4000000>;
			/* 2 GiB window starting at 0x80000000 (address cells 2, size 1) */
			alloc-ranges = <0x0 0x80000000 0x80000000>;
			linux,cma-default;
		};

		/*
		 * Device-verified persistent log area, supplied by the user.
		 * The stock Android 4.14 recovery kernel reads this area with the
		 * same 2 MiB reservation, so the partition layout below is chosen
		 * to be recoverable by it. See the buffer-size comment.
		 */
		ramoops@f9d10000 {
			compatible = "ramoops";
			reg = <0x0 0xf9d10000
			       0x00200000>;
			/* Keep the region out of the linear map: ramoops vmaps it itself. */
			no-map;
			/*
			 * Write-combined: records reach DRAM immediately, so a panic
			 * record cannot be lost in a dirty cache. Mapping changes were
			 * measured and do not affect the ~7 % single-bit damage these
			 * records carry; see notes/progress.md 2026-11-10.
			 */
			mem-type = <0>;

			/*
			 * Recovery (4.14) initializes zones in the order dmesg,
			 * console, ftrace, pmsg; mainline initializes dmesg, console,
			 * pmsg, ftrace. Equal 512 KiB buffers therefore put pmsg at
			 * the offset recovery reads as ftrace and vice versa, and the
			 * ftrace signature (LINUX_VERSION_CODE) makes those records
			 * unreadable across kernel versions.
			 *
			 * Resulting map at 0xf9d10000:
			 *   0x000000 dmesg   0x080000  -> recovery dmesg
			 *   0x080000 console 0x100000  -> recovery console (same start)
			 *   0x180000 pmsg    0x080000  -> recovery pmsg (same start)
			 *
			 * Keep console output below 512 KiB: recovery only maps
			 * 512 KiB there and rejects a larger record as an invalid
			 * existing buffer. ftrace is disabled because its records are
			 * never readable by another kernel version anyway.
			 */
			record-size = <0x00080000>;
			console-size = <0x00100000>;
			ftrace-size = <0>;
			pmsg-size = <0x00080000>;
			max-reason = <0>;
		};
	};

};

&pinctrl_alive {
	key_volup: key-volup-pins {
		/* Match the vendor A51 key pin configuration. */
		samsung,pins = "gpa1-5";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa1-6";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};

	key_power: key-power-pins {
		samsung,pins = "gpa1-7";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

/*
 * UFS (embedded).  Registers, GPIOs and the reset/refclk pin functions come
 * from DOWNSTREAM_READONLY/arch/arm64/boot/dts/exynos/exynos9610.dts:2678-2778.
 * vcc-supply is a fixed always-on regulator gated by gpg4-0 on the A51.
 */
/ {
	reg_ufs_vcc: regulator-ufs-vcc {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpg4 0 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		enable-active-high;
	};

	ufs: ufs@13520000 {
		compatible = "samsung,exynos9610-ufs";
		reg = <0x0 0x13520000 0x200>,	/* hci */
		      <0x0 0x13521100 0x200>,	/* vs_hci */
		      <0x0 0x13510000 0x8000>,	/* unipro */
		      <0x0 0x13530000 0x1000>;	/* ufsp */
		reg-names = "hci", "vs_hci", "unipro", "ufsp";
		interrupts = <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cmu_fsys CLK_FSYS_GOUT_UFS_EMBD_QCH_UFS>,
			 <&cmu_fsys CLK_FSYS_GOUT_UFS_EMBD_UNIPRO>;
		clock-names = "core_clk", "sclk_unipro_main";
		freq-table-hz = <0 0>, <0 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&ufs_rst_n &ufs_refclk_out>;
		phys = <&ufs_phy>;
		phy-names = "ufs-phy";
		vcc-supply = <&reg_ufs_vcc>;
		vcc-fixed-regulator;
		samsung,sysreg = <&sysreg_fsys 0x1010>;
		dma-coherent;
		status = "okay";
	};

	ufs_phy: ufs-phy@13524000 {
		compatible = "samsung,exynos9610-ufs-phy";
		reg = <0x0 0x13524000 0x800>;
		reg-names = "phy-pma";
		samsung,pmu-syscon = <&pmu_system_controller 0x724>;
		clocks = <&oscclk_fsys>;
		clock-names = "ref_clk";
		#phy-cells = <0>;
		status = "okay";
	};
};

/*
 * Legacy I2C buses, enabled purely for discovery: the vendor A51 board DTS is
 * not available, so which bus carries the PMIC / charger / fuel gauge is
 * unknown.  All seven are scanned read-only with i2cdetect; unused ones get
 * disabled again once the device map is known.
 */
&i2c_0 {
	status = "okay";
};

/*
 * Touch controller supply.  The vendor feeds the Melfas panel from a fixed
 * 3.0 V rail gated by gpg3-1 and leaves it on from boot
 * (DOWNSTREAM_READONLY/arch/arm64/boot/dts/samsung/exynos9611-a51_common.dtsi:524-532).
 */
/ {
	tsp_ldo_en: regulator-tsp-ldo-en {
		compatible = "regulator-fixed";
		regulator-name = "tsp_ldo_en";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		gpio = <&gpg3 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

&i2c_4 {
	status = "okay";

	touchscreen@48 {
		compatible = "melfas,mss100";
		reg = <0x48>;
		pinctrl-names = "default";
		pinctrl-0 = <&attn_irq>;
		vdd-supply = <&tsp_ldo_en>;
	};
};

&pinctrl_alive {
	attn_irq: attn-irq-pins {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
		samsung,pin-drv = <0>;
	};
};

&i2c_1 {
	status = "okay";
};

&i2c_2 {
	status = "okay";
};

&i2c_3 {
	status = "okay";
};

&i2c_4 {
	status = "okay";
};

&i2c_5 {
	status = "okay";
};

&i2c_6 {
	status = "okay";
};

/*
 * SM5713 fuel gauge (I2C address 0x71).  The chip also provides the charger
 * (0x49) and MUIC (0x25) on i2c_1 and a USB-PD controller on i2c_0; only the
 * fuel gauge has a mainline driver so far.
 */
&i2c_1 {
	fuel_gauge: fuel-gauge@71 {
		compatible = "siliconmitus,sm5713-fuelgauge";
		reg = <0x71>;
	};

	charger: charger@49 {
		compatible = "samsung,sm5713-charger";
		reg = <0x49>;
	};

	muic: muic@25 {
		compatible = "samsung,sm5713-muic";
		reg = <0x25>;
	};
};

/*
 * Thermal zone.  The TMU block carries several sensing points across the
 * BIG, LITTLE, G3D and ISP channels; the driver reports the hottest of the
 * live ones, so a single zone covers the whole SoC.  Per-channel zones need
 * the channel/sensing point mapping, which is not established yet.
 *
 * There is no cooling device (CPU DVFS is firmware owned and does not answer
 * mainline), so passive trips only document intent; the critical trip is the
 * one that acts, and it performs an orderly shutdown at the vendor default of
 * 115 C.  The decode behind it was validated against the fuel gauge.
 */
/ {
	thermal-zones {
		/*
		 * Extra sensing points, deliberately WITHOUT trip points: a zone
		 * with no trips can only report, never act, so a wrong decode
		 * cannot shut the device down.  Sensor ids: 0-7 are the eight
		 * packed 9-bit codes (two per register), 8 is the driver's
		 * synthetic "hottest trimmed point" id.  Add trips only after
		 * the decode has been checked on hardware.
		 */
		package-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&tmu 2>;
		};

		hottest-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&tmu 8>;
		};

		/*
		 * The CPU cluster throttling zone.  Without cooling maps a zone
		 * can only report, which is how the device ran until now: an
		 * all-core load at the boot operating points settles at 50 C, but
		 * the top operating points reach 111 C in 12 s and the platform
		 * shuts down.
		 *
		 * Each trip forces a minimum cooling state instead of relying on
		 * step_wise stepping one state per poll: that governor only steps
		 * while the trend is rising, so it stalls once the temperature
		 * plateaus above the trip (observed: state 4 of 14 at 92 C).  A
		 * lower bound in the cooling map is applied as soon as the trip is
		 * crossed, which makes the reaction deterministic.
		 */
		soc-thermal {
			polling-delay = <500>;
			polling-delay-passive = <500>;
			thermal-sensors = <&tmu 0>;

			trips {
				cpu_alert0: cpu-alert-0 {
					temperature = <65000>;
					hysteresis = <4000>;
					type = "passive";
				};
				cpu_alert1: cpu-alert-1 {
					temperature = <75000>;
					hysteresis = <4000>;
					type = "passive";
				};
				cpu_alert2: cpu-alert-2 {
					temperature = <85000>;
					hysteresis = <4000>;
					type = "passive";
				};
				soc_hot: soc-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "hot";
				};
				soc_crit: soc-critical {
					temperature = <100000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_alert0>;
					cooling-device = <&cpu0 3 THERMAL_NO_LIMIT>,
							 <&cpu4 3 THERMAL_NO_LIMIT>;
				};
				map1 {
					trip = <&cpu_alert1>;
					cooling-device = <&cpu0 7 THERMAL_NO_LIMIT>,
							 <&cpu4 7 THERMAL_NO_LIMIT>;
				};
				/*
				 * 9 and not 11: a bound above the cooling
				 * device's max_state makes the bind fail with
				 * -EINVAL, and with the default volt_scale=0 the
				 * policies only expose ten levels.
				 */
				map2 {
					trip = <&cpu_alert2>;
					cooling-device = <&cpu0 9 THERMAL_NO_LIMIT>,
							 <&cpu4 9 THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};

/*
 * Display processing unit.  The Samsung boot chain already brings DECON, DSIM
 * and the panel up before Linux starts, so the handoff driver only needs the
 * pipe enabled and the panel mode described.  The timings below are the A51's
 * 1080x2400 command-mode panel mode; they are reported to userspace and used
 * to validate modes, DSIM bring-up is still to come.
 */
/*
 * The panel hangs off the DSI host: the driver speaks DCS to it over the link
 * the boot chain brought up, and takes over its power-on sequence, brightness
 * and display on/off from there.
 */
&dsim {
	status = "okay";

	panel: panel@0 {
		compatible = "samsung,ea8076";
		reg = <0>;

		/*
		 * The two panel rails are switched by GPIOs, not by regulators:
		 * 1.8 V comes up first, the 3.0 V rail follows 1 ms later.  The
		 * reset line is active low and is pulsed once the rails are up.
		 */
		enable-gpios = <&gpg1 2 GPIO_ACTIVE_HIGH>,	/* 1.8 V */
			       <&gpg2 4 GPIO_ACTIVE_HIGH>;	/* 3.0 V */
		reset-gpios = <&gpg1 3 GPIO_ACTIVE_LOW>;
	};
};

/*
 * The panel drives TE over a wire into DECON's TE input (vendor "decon_f_te_on":
 * gpc2-3 at function 0xf).  gpc2 belongs to pin-controller 4 (pinctrl@139B0000),
 * not ALIVE.  Without this mux nothing ever sees a tearing effect and a
 * command-mode panel simply keeps showing its last frame: commits and vblanks
 * all look healthy while nothing reaches the glass.
 */
&pinctrl_top {
	decon_f_te_on: decon-f-te-on-pins {
		samsung,pins = "gpc2-3";
		samsung,pin-function = <0xf>;
		samsung,pin-pud = <0>;
	};
};

&decon {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&decon_f_te_on>;
	/*
	 * The DPU IDMA channel takes plain 32-bit physical addresses, so its
	 * scanout buffers must be contiguous low memory.  Bind the shared CMA
	 * pool to this device explicitly: the generic "linux,cma-default" area
	 * is not picked up for this platform, and without it every buffer above
	 * MAX_ORDER falls back to the buddy allocator and fails.
	 */
	memory-region = <&cma_reserved>;

	display-timings {
		native-mode = <&panel_timing>;

		panel_timing: timing0 {
			clock-frequency = <162000000>;
			hactive = <1080>;
			vactive = <2400>;
			hfront-porch = <20>;
			hback-porch = <10>;
			hsync-len = <5>;
			vfront-porch = <8>;
			vback-porch = <8>;
			vsync-len = <4>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};
	};
};

/* CPU cluster clock control (AP-side cpufreq). */
&cpuclk {
	status = "okay";
};

/*
 * The LITTLE rail hangs the SoC between 637.5 mV and 600 mV (600 mV being what
 * the vendor table asks for at 403 MHz), so it is never written below 650 mV.
 * The big rail tolerated 600 mV in the same test, but keeping one floor for both
 * is simpler and still well clear of every operating point it has to reach.
 */
&cpuclk0 {
	samsung,rail-floor-uv = <650000>;
};
