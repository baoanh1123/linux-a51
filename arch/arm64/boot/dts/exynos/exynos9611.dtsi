	/*
	 * Legacy (s3c2440-style) I2C controllers.  Addresses, interrupts and pin
	 * groups come from DOWNSTREAM_READONLY/arch/arm64/boot/dts/exynos/
	 * exynos9610.dts:1667+ and exynos9610-pinctrl.dtsi:1083-1141.  The
	 * controller clock is the PERI PCLK gate, as in the vendor tree and in
	 * exynos7870.dtsi (the driver derives its clock divider from it).
	 */
	i2c_1: i2c@13840000 {
		compatible = "samsung,exynos9610-i2c", "samsung,s3c2440-i2c";
		reg = <0x0 0x13840000 0x100>;
		interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;
		samsung,i2c-sda-delay = <100>;
		samsung,i2c-max-bus-freq = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_bus>;
		clock-names = "i2c";
		clocks = <&cmu_peri CLK_PERI_I2C_1_QCH>;
		status = "disabled";
	};

	i2c_2: i2c@13850000 {
		compatible = "samsung,exynos9610-i2c", "samsung,s3c2440-i2c";
		reg = <0x0 0x13850000 0x100>;
