	/*
	 * Display processing unit, "DPU 2.0".  Addresses and the window 0
	 * IDMA channel mapping are from
	 * DOWNSTREAM_READONLY/arch/arm64/boot/dts/exynos/exynos9610.dts:2890-2996
	 * and were confirmed against the live register state of the running
	 * pipeline: DECON window 0 is fed by IDMA G0 at 0x14881000.
	 *
	 * Only the blocks the Linux handoff driver takes over are described:
	 * DSIM, the DSI PHY and the panel stay under boot chain control.
	 */
	/*
	 * SYSREG_DISPAUD: display subsystem glue registers.  Bit 0/1 of the
	 * MIPI PHY control register at +0x8 hold the M4S4 D-PHY resets and
	 * bit 4/5 select whether DSIM or the SYSREG drives them.
	 */
	disp_ss: syscon@14811000 {
		compatible = "samsung,exynos9-disp_ss", "syscon";
		reg = <0x0 0x14811000 0x10>;
	};

	/*
	 * MIPI DSIM master.  The Samsung boot chain brings this link up (PLL,
	 * D-PHY, command mode) before Linux starts; until the mainline driver
	 * learns to do that itself it only reads the inherited state.
	 */
	dsim: dsi@148e0000 {
		compatible = "samsung,exynos9610-dsim";
		reg = <0x0 0x148e0000 0x100>;
		interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;
		samsung,pmu-syscon = <&pmu_system_controller>;
		samsung,disp-sysreg = <&disp_ss>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	/*
	 * Mali-G72 power domain (vendor DT: pd-g3d@11864060, i.e. PMU + 0x4060).
	 * The domain is secure-world managed: every transition has to be wrapped
	 * in the vendor's TZPC save/restore SMC or the interconnect answers with a
	 * SError (see notes/gpu.md).  The vendor also keeps PLL_G3D running and
	 * only stops clocks, so the driver restores the CMU_G3D register file on
	 * power-up.
	 */
	pd_g3d: power-domain@11860000 {
		compatible = "samsung,exynos9610-g3d-pd";
		reg = <0x0 0x11860000 0x8000>,	/* PMU */
		      <0x0 0x11430000 0x4000>,	/* CMU_G3D */
		      <0x0 0x11410000 0x1000>;	/* CMU_PWR (LPP/DRCG) */
		reg-names = "pmu", "cmu-g3d", "cmu-pwr";
		#power-domain-cells = <0>;
	};

	decon: display-controller@148b0000 {
		compatible = "samsung,exynos9610-decon";
		reg = <0x0 0x148b0000 0x10000>,
		      <0x0 0x14881000 0x1000>;
		reg-names = "decon", "idma";
		/*
		 * SPI 199 is frame start, 203 the error/timeout summary, 266 the
		 * panel TE (the same signal the vendor wires to DECON's hardware
		 * trigger): the panel tells us when it is ready for a new frame.
		 */
		interrupts = <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>,	/* frame done */
			     <GIC_SPI 266 IRQ_TYPE_LEVEL_HIGH>;	/* panel TE */
		interrupt-names = "done", "te";
		samsung,dsi-controller = <&dsim>;
		status = "disabled";
	};

	/*
	 * Mali-G72 MP3.  Panfrost builds its page tables with the GPU's own MMU
	 * (io-pgtable), so no system MMU is needed here - the vendor device tree
	 * has none either.  Power domain and clocks are still inherited from the
	 * boot loader: pd-g3d sits at PMU+0x4060 and the G3D CMU gates are not
	 * modelled yet, so a fixed clock reports the nominal rate until they are.
	 */
	gpu_clk: gpu-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <1053000000>;
	};

	gpu: gpu@11500000 {
		compatible = "arm,mali-bifrost";
		reg = <0x0 0x11500000 0x5000>;
		interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>,	/* GPU */
			     <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,	/* JOB */
			     <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;	/* MMU */
		interrupt-names = "gpu", "job", "mmu";
		clocks = <&gpu_clk>;
		status = "okay";
		power-domains = <&pd_g3d>;
	};
};
